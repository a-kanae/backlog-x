{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/projects/*/issues/*.txt",
        "destination": "/projects/_/issues/_.txt"
      },
      {
        "source": "/projects/*/issues/**",
        "destination": "/projects/_/issues/_.html"
      },
      {
        "source": "/projects/*/wikis/*.txt",
        "destination": "/projects/_/wikis/_.txt"
      },
      {
        "source": "/projects/*/wikis/**",
        "destination": "/projects/_/wikis/_.html"
      },
      {
        "source": "/projects/*/wikis.txt",
        "destination": "/projects/_/wikis.txt"
      },
      {
        "source": "/projects/*/wikis",
        "destination": "/projects/_/wikis.html"
      },
      {
        "source": "/projects/*/documents/*.txt",
        "destination": "/projects/_/documents/_.txt"
      },
      {
        "source": "/projects/*/documents/**",
        "destination": "/projects/_/documents/_.html"
      },
      {
        "source": "/projects/*/documents.txt",
        "destination": "/projects/_/documents.txt"
      },
      {
        "source": "/projects/*/documents",
        "destination": "/projects/_/documents.html"
      },
      {
        "source": "/projects/*.txt",
        "destination": "/projects/_.txt"
      },
      {
        "source": "/projects/**",
        "destination": "/projects/_.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://*.backlog.jp https://*.backlog.com https://*.backlogtool.com; worker-src 'self' blob:; child-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": false
    }
  }
}
